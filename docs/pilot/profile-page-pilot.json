        "id": "lint",
        "kind": "lint",
        "scope": "local",
        "stages": ["baseline", "candidate"],
        "command": ["npx", "eslint", "."],
        "publisher": "isolated-checker",
        "timeoutMs": 120000
      },
      {
        "id": "type",
        "kind": "type",
        "scope": "local",
        "stages": ["baseline", "candidate"],
        "command": ["npm", "run", "-s", "check"],
        "publisher": "isolated-checker",
        "timeoutMs": 120000
      },
      {
        "id": "coverage",
        "kind": "coverage",
        "scope": "local",
        "stages": ["baseline", "candidate"],
        "command": [
          "sh",
          "-c",
          "npx svelte-kit sync && npx vitest run --coverage"
        ],
        "publisher": "isolated-checker",
        "timeoutMs": 120000
      },
      {
        "id": "build",
        "kind": "build",
        "scope": "local",
        "stages": ["baseline", "candidate"],
        "command": ["npm", "run", "-s", "build"],
        "publisher": "isolated-checker",
