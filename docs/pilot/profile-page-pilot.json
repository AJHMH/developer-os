      {
        "id": "e2e",
        "kind": "e2e",
        "scope": "local",
        "stages": ["baseline", "candidate"],
        "command": [
          "sh",
          "-c",
          "export CI=1 EMAIL_SERVICE=console && npx prisma db push && npx playwright test --reporter=line"
        ],
        "publisher": "isolated-checker",
        "timeoutMs": 120000
      },
      {
        "id": "skip-link",
        "kind": "acceptance",
        "scope": "local",
        "stages": ["candidate"],
        "command": [
          "node",
          "-e",
          "const s = require(\"fs\").readFileSync(\"src/routes/+layout.svelte\", \"utf8\"); const m = s.match(/<a\\b[^>]*\\bhref=\"#([A-Za-z][\\w-]*)\"[^>]*>\\s*Skip to (?:main )?content\\s*<\\/a>/i); if (!m) throw Error(\"No skip link to an in-page target\"); if (!new RegExp(\"<main\\\\b[^>]*\\\\bid=\\\"\" + m[1] + \"\\\"\").test(s)) throw Error(\"The main element lacks the link target id\"); if (s.indexOf(m[0]) > s.indexOf(\"<nav\")) throw Error(\"The skip link is not before the navigation\");"
        ],
        "publisher": "isolated-checker",
        "timeoutMs": 120000
      },
      {
        "id": "skip-link-browser",
        "kind": "e2e",
        "scope": "local",
        "stages": ["candidate"],
        "command": [
          "node",
          "-e",
          "const fs = require(\"fs\"), { spawnSync } = require(\"child_process\"); const env = { ...process.env, CI: \"1\", EMAIL_SERVICE: \"console\" }; const run = (a) => { const r = spawnSync(\"npx\", a, { stdio: \"inherit\", env }); if (r.status !== 0) process.exit(r.status || 1); }; const d = \"test-results/aios-pilot\"; fs.mkdirSync(d, { recursive: true }); fs.writeFileSync(d + \"/skip-link.spec.ts\", \"import { test, expect } from \\\"@playwright/test\\\";\\nfor (const path of [\\\"/\\\", \\\"/about\\\", \\\"/contact\\\"]) test(\\\"skip link on \\\" + path, async ({ page }) => {\\n  await page.goto(path);\\n  const link = page.getByRole(\\\"link\\\", { name: /skip to (main )?content/i });\\n  const hidden = await link.boundingBox();\\n  expect(!hidden || hidden.width <= 1 || hidden.y + hidden.height <= 0).toBeTruthy();\\n  await page.keyboard.press(\\\"Tab\\\");\\n  await expect(link).toBeFocused();\\n  await expect(link).toBeInViewport();\\n  const href = await link.getAttribute(\\\"href\\\");\\n  await page.keyboard.press(\\\"Enter\\\");\\n  await expect(page).toHaveURL(new RegExp(href + \\\"$\\\"));\\n  await expect(page.locator(\\\"main\\\" + href)).toHaveCount(1);\\n});\\n\"); fs.writeFileSync(d + \"/playwright.config.ts\", \"import base from \\\"../../playwright.config\\\";\\nexport default { ...base, testDir: \\\".\\\", testMatch: \\\"skip-link.spec.ts\\\", outputDir: \\\"./results\\\" };\\n\"); run([\"prisma\", \"db\", \"push\"]); run([\"playwright\", \"test\", \"--config\", d + \"/playwright.config.ts\", \"--reporter=line\"]);"
        ],
        "publisher": "isolated-checker",
        "timeoutMs": 120000
      },
      {
        "id": "Lint, Type Check, Test, Build",
        "kind": "build",
        "scope": "pr",
        "stages": ["candidate"],
        "command": ["workflow", "ci"],
        "publisher": "github-actions",
        "workflow": ".github/workflows/ci.yml@main",
        "timeoutMs": 1800000
