{
  "scope": "aios-pilot-v1",
  "repository": "AJHMH/profile-page",
  "signedCommit": "0000000000000000000000000000000000000000",
  "request": "Add a \"Skip to content\" link for keyboard users to every page: the first thing Tab reaches, hidden until it has focus, that moves focus to the page's main content.",
  "criteria": [
    "On every page, the first Tab focuses a link that reads \"Skip to content\" and points at an in-page target.",
    "The link is visually hidden until it has focus, and visible in the viewport while focused.",
    "Activating the link moves to the page's main element, which carries the link's target id.",
    "The existing format, lint, type, coverage, build and E2E checks, including the axe checks, still pass."
  ],
  "verification": [
    "The skip-link check reads the layout: a skip link before the navigation, targeting the main element's id.",
    "The skip-link-browser check tabs to the link on /, /about and /contact in Chromium, and follows it to main."
  ],
  "requiredChecks": [
    "Lint, Type Check, Test, Build",
    "Semgrep Security Scan",
    "e2e"
  ],
  "excludedPaths": [
    ".agents/",
    ".claude/",
    ".env.example",
    ".gitattributes",
    ".npmrc"
  ],
  "libc": "glibc",
  "database": true,
  "browser": true,
  "budgetDollars": 10,
  "codingMinutes": 30,
  "repairCycles": 2,
  "checksWaitMinutes": 30,
  "reviewWaitMinutes": 240,
  "requireOwnerApproval": true,
