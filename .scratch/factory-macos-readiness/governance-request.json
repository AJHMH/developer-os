{
  "name": "Factory governed default branch",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "validation / Execute Factory Contract Validation",
            "integration_id": 15368
          },
          {
            "context": "validation / Verify Factory safety controls",
            "integration_id": 15368
          },
          {
            "context": "validation / Evaluate trusted execution policy",
            "integration_id": 15368
          },
          {
            "context": "validation / Enforce Factory coverage",
            "integration_id": 15368
          },
          {
            "context": "validation / Enforce Factory secret and dependency policy",
            "integration_id": 15368
          },
          {
            "context": "validation / Enforce Factory SAST policy",
            "integration_id": 15368
          },
          {
            "context": "validation / Enforce Factory human approval",
            "integration_id": 15368
          },
          {
            "context": "validation / Enforce Factory trusted human approval",
            "integration_id": 15368
          },
          {
            "context": "Validate Developer OS CLI",
            "integration_id": 15368
          },
          {
            "context": "Analyze Developer OS CLI",
            "integration_id": 15368
          },
          {
            "context": "Analyze GitHub Actions workflows",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
