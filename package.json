{
  "name": "developer-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "bin": {
    "aios": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "test:cli": "npm run build && node --test tests/delivery.test.mjs",
    "start": "node dist/cli.js",
    "format": "prettier --write src tests scripts package.json tsconfig.json README.md",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json README.md",
    "acceptance:macos": "node scripts/run-native-acceptance.mjs \"$HOME/.developer-os/ticket4-macos/state\" .scratch/aios-v1-implementation/macos-roundtrip-acceptance.mjs .scratch/aios-v1-implementation/macos-fencing-acceptance.mjs .scratch/aios-v1-implementation/macos-isolation-acceptance.mjs --"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
